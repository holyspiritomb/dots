{
  "coc.preferences.bracketEnterImprove": true,
  "coc.preferences.extensionUpdateUIInTab": true,
  "coc.preferences.maxFileSize": "1MB",
  "coc.preferences.messageLevel": "more",
  "coc.source.file.enable": true,
  "css.hover.documentation": true,
  "css.lint.emptyRules": "ignore",
  "css.lint.unknownAtRules": "ignore",
  "css.format.enable": false,
  "css.validate": false,
  "diagnostic.displayByAle": true,
  "diagnostic.format": "%message (%source%code)",
  "svg.format.plugins": {
      "sortAttrs": true,
  },
  "dialog.maxHeight": 10,
  "dialog.maxWidth": 60,
  "diagnostic.virtualText": true,
  "diagnostic.virtualTextAlign": "below",
  "html-css-support.enable": true,
  "html.hover.documentation": true,
  "html.suggest.html5": true,
  "less.hover.documentation": true,
  "less.hover.references": true,
  "lightbulb.enableVirtualText": true,
  "lightbulb.text": {"default": "󰌵","quickfix": "󰁨",},
  "python.analysis.autoImportCompletions": true,
  "python.linting.enabled": false,
  "python.venvPath": "/home/spiritomb/.venvs",
  "scss.completion.completePropertyWithSemicolon": true,
  "scss.completion.triggerPropertyValueCompletion": true,
  "scss.hover.documentation": true,
  "scss.hover.references": true,
  "scss.lint.compatibleVendorPrefixes": "ignore",
  "snippets.loadFromExtensions": true,
  "snippets.ultisnips.pythonPrompt": false,
  "stylelint.enable": true,
  "suggest.enableFloat": true,
  "suggest.filterOnBackspace": true,
  "suggest.floatConfig": {"rounded": true, "shadow": true},
  "suggest.maxCompleteItemCount": 25,
  "suggest.minTriggerInputLength": 1,
  "suggest.virtualText": false,
  "tsserver.experimental.enableProjectDiagnostics": false,
  "tsserver.useLocalTsdk": true,
  "vimlsp.suggest.fromRuntimepath": true,
  "vimlsp.suggest.fromVimruntime": true,
  "volar.enable": true,
  "volar.useWorkspaceTsdk": true,
  "vue.inlayHints.missingProps": true,
  "vue.inlayHints.optionsWrapper": true,
  "vue.server.hybridMode": true,
  "diagnostic.floatConfig": {
    "maxWidth": 60,
    "border": true,
    "rounded": true,
    "close": true
  },
  "python.analysis.diagnosticSeverityOverrides": {
    "reportDuplicateImport": "warning",
    "reportAssignmentType": "none",
    "reportArgumentType": "none",
    "reportIncompatibleMethodOverride": "none",
    "reportMissingModuleSource": "warning",
    "reportGeneralTypeIssues": "information",
    "reportUnusedClass": "information",
    "reportUnusedImport": "information",
    "reportUnusedVariable": "information",
    "reportOptionalMemberAccess": false
  },
  "extensions.updateCheck": "never"
}
